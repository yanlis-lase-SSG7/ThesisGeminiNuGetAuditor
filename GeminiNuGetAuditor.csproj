<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".github\copilot-instructions.md" />
    <None Include="Thesis_Dataset_1000\**\*.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="samples\**\*.cs" />
    <None Remove="samples\**\*" />
    <Content Remove="samples\**\*" />
    <EmbeddedResource Remove="samples\**\*" />
    <None Update="my-note.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="samples\**\*" Exclude="samples\**\bin\**;samples\**\obj\**" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="audit-results\" />
    <Folder Include="samples\" />
    <Folder Include="Thesis_Dataset_1000\" />
  </ItemGroup>

</Project>
